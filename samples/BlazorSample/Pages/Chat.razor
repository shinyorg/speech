@page "/chat"
@inject ConversationHost Host
@implements IDisposable

<PageTitle>Chat</PageTitle>

<div class="chat-container">
    <div class="chat-header">
        <span>@(session?.Title ?? "Chat")</span>
        <button class="btn-primary" @onclick="NewConversation">New conversation</button>
    </div>

    <div class="chat-messages">
        @foreach (var msg in messages)
        {
            <div class="chat-bubble @(msg.IsUser ? "mine" : "theirs")">
                <div class="bubble-text">@msg.Text</div>
                @if (msg.Footer != null)
                {
                    <div class="bubble-time">@msg.Footer</div>
                }
                <div class="bubble-time">@msg.Timestamp.ToLocalTime().ToString("h:mm tt")</div>
            </div>
        }

        @if (isBusy && !streamingVisible)
        {
            <div class="chat-bubble theirs">
                <div class="bubble-text typing-indicator">
                    <span></span><span></span><span></span>
                </div>
            </div>
        }

        @if (!isBusy && session != null)
        {
            @foreach (var question in session.PendingQuestions.Where(x => x.HasChoices))
            {
                <div class="chat-choices">
                    @foreach (var choice in question.Choices!)
                    {
                        <button class="btn-primary" @onclick="() => Answer(question, choice)">@choice.Label</button>
                    }
                </div>
            }
        }
    </div>

    <div class="chat-input-bar">
        <input type="text"
               @bind="inputText"
               @bind:event="oninput"
               @onkeydown="HandleKeyDown"
               placeholder="Ask something..."
               disabled="@(session == null)" />
        <button class="send-button"
                @onclick="Send"
                disabled="@(String.IsNullOrWhiteSpace(inputText) || session == null)">
            Send
        </button>
    </div>
</div>

@code {
    sealed class Bubble
    {
        public required string Id { get; init; }
        public bool IsUser { get; init; }
        public string Text { get; set; } = "";
        public string? Footer { get; set; }
        public DateTimeOffset Timestamp { get; init; }
    }

    readonly List<Bubble> messages = [];
    string inputText = "";
    IAiSession? session;
    CancellationTokenSource? cts;
    string? streamingId;
    bool isBusy;
    bool streamingVisible;

    protected override async Task OnInitializedAsync()
    {
        Host.SessionChanged += OnSessionChanged;
        await Show(await Host.GetSession());
    }

    async Task Show(IAiSession s)
    {
        cts?.Cancel();
        cts = new CancellationTokenSource();
        session = s;
        messages.Clear();
        streamingId = null;
        streamingVisible = false;

        var page = await s.GetMessages(null, 50);
        foreach (var m in page.Messages)
            Upsert(m);

        isBusy = s.State is AiSessionState.Thinking or AiSessionState.Responding;
        var token = cts.Token;
        _ = Listen(s, token);
        StateHasChanged();
    }

    async Task Listen(IAiSession s, CancellationToken ct)
    {
        try
        {
            await foreach (var e in s.GetEvents(ct))
                await InvokeAsync(() => OnEvent(e));
        }
        catch (OperationCanceledException) { }
    }

    void OnEvent(AiSessionEvent e)
    {
        switch (e)
        {
            case MessageAdded { Message: { Role: MessageRole.Assistant, Status: MessageStatus.Streaming } m }:
                streamingId = m.MessageId;
                streamingVisible = false;
                break;

            case MessageAdded m:
                Upsert(m.Message);
                break;

            case TurnEventOccurred { Event: TextDelta d } when streamingId != null:
                var bubble = messages.FirstOrDefault(x => x.Id == streamingId);
                if (bubble == null)
                {
                    bubble = new Bubble { Id = streamingId, IsUser = false, Timestamp = DateTimeOffset.Now };
                    messages.Add(bubble);
                }
                bubble.Text += d.Text;
                streamingVisible = true;
                break;

            case MessageUpdated m:
                Upsert(m.Message);
                if (m.Message.MessageId == streamingId && m.Message.Status != MessageStatus.Streaming)
                    streamingId = null;
                break;

            case StateChanged s:
                isBusy = s.State is AiSessionState.Thinking or AiSessionState.Responding;
                break;

            case TitleChanged:
                break;

            case SessionError err:
                messages.Add(new Bubble { Id = Guid.NewGuid().ToString("N"), Text = $"Error: {err.Error.Message}", Timestamp = DateTimeOffset.Now });
                break;
        }
        StateHasChanged();
    }

    // only user and assistant text get a bubble; tool calls, memory and summaries don't
    void Upsert(AiMessageDocument m)
    {
        if (m.Role is not (MessageRole.User or MessageRole.Assistant) || String.IsNullOrWhiteSpace(m.Text))
            return;

        var bubble = messages.FirstOrDefault(x => x.Id == m.MessageId);
        if (bubble == null)
        {
            bubble = new Bubble { Id = m.MessageId, IsUser = m.Role == MessageRole.User, Timestamp = m.Timestamp };
            messages.Add(bubble);
        }
        bubble.Text = m.Text!;
        bubble.Footer = m.Usage is { } u ? AiChatTokens.FormatTokenFooter(u.InputTokens, u.OutputTokens, u.TotalTokens) : null;
    }

    void Send()
    {
        if (String.IsNullOrWhiteSpace(inputText) || session == null)
            return;

        var text = inputText;
        inputText = "";
        session.Send(AiInput.Text(text));
    }

    void Answer(AiQuestion question, AiChoice choice) => session?.Send(AiInput.Answer(question, choice.Id));

    async Task NewConversation() => await Host.NewConversation();

    void OnSessionChanged(object? sender, IAiSession s) => InvokeAsync(() => Show(s));

    void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
            Send();
    }

    public void Dispose()
    {
        Host.SessionChanged -= OnSessionChanged;
        cts?.Cancel();
    }
}
