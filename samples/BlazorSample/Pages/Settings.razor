@page "/settings"
@inject ConversationHost Host
@inject CloudProviderCredentials Creds
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Settings</PageTitle>

<div class="settings-container">
    <div class="settings-section">
        <h3>Status</h3>
        <div class="settings-card">
            <div class="settings-row">
                <span class="settings-label">Voice Status</span>
                <span class="settings-value">@Host.Voice.State</span>
            </div>
            <div class="settings-row">
                <span class="settings-label">Context</span>
                <span class="settings-value">@contextText</span>
            </div>
        </div>
    </div>

    <div class="settings-section">
        <h3>Conversation</h3>
        <div class="settings-card">
            <button class="btn-primary" @onclick="NewConversation">New Conversation</button>
            <button class="btn-primary" @onclick="Compact">Compact Conversation</button>
            @if (statusMessage != null)
            {
                <span class="settings-value">@statusMessage</span>
            }
        </div>
    </div>

    <div class="settings-section">
        <h3>Response Mode</h3>
        <p class="settings-footer">Controls how the AI acknowledges responses.</p>
        <div class="settings-card">
            <div class="settings-row">
                <label class="settings-label" for="acknowledgement">Acknowledgement</label>
                <select id="acknowledgement" value="@selectedAcknowledgement" @onchange="OnAcknowledgementChanged">
                    @foreach (var option in Enum.GetNames<AiAcknowledgement>())
                    {
                        <option value="@option">@option</option>
                    }
                </select>
            </div>
            <div class="settings-row">
                <label class="settings-label" for="interruption">Interruption</label>
                <select id="interruption" value="@selectedInterruption" @onchange="OnInterruptionChanged">
                    @foreach (var option in Enum.GetNames<InterruptionMode>())
                    {
                        <option value="@option">@option</option>
                    }
                </select>
            </div>
        </div>
    </div>

    @if (Creds.IsActive)
    {
        <div class="settings-section">
            <h3>@Creds.ProviderName API Credentials</h3>
            <p class="settings-footer">Saved to your browser and reused on next launch; changes take effect on the next speech request.</p>
            <div class="settings-card">
                @foreach (var field in Creds.Fields)
                {
                    <div class="settings-row" style="flex-direction: column; align-items: stretch;">
                        <label class="settings-label" for="@field.StoreKey">@field.Label</label>
                        <input id="@field.StoreKey" type="text" @bind="field.Value" placeholder="Enter value" />
                    </div>
                }
                <button class="btn-primary" @onclick="SaveKeys">Apply Keys</button>
                @if (keysSaved)
                {
                    <span class="settings-value">Saved ✓</span>
                }
            </div>
        </div>
    }

    <div class="settings-section">
        <h3>Danger Zone</h3>
        <div class="settings-card">
            <button class="btn-danger" @onclick="ClearHistory">Delete All Conversations</button>
        </div>
    </div>

</div>

@code {
    readonly CancellationTokenSource cts = new();
    string selectedAcknowledgement = "";
    string selectedInterruption = "";
    string? contextText;
    string? statusMessage;
    bool keysSaved;

    protected override async Task OnInitializedAsync()
    {
        selectedAcknowledgement = Host.VoiceOptions.Acknowledgement.ToString();
        selectedInterruption = Host.VoiceOptions.Interruption.ToString();
        ShowContext(await Host.GetSession());
        _ = WatchVoice(cts.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Make sure the fields reflect the persisted values even on a direct navigation to /settings.
        if (firstRender && Creds.IsActive)
        {
            await Creds.RestoreFromStoreAsync(JS);
            StateHasChanged();
        }
    }

    async Task WatchVoice(CancellationToken ct)
    {
        try
        {
            await foreach (var _ in Host.Voice.GetEvents(ct))
                await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
    }

    void ShowContext(IAiSession session)
    {
        var c = session.Context;
        contextText = c.MaxTokens is { } max
            ? $"{c.CurrentTokens:N0} of {max:N0} tokens ({c.Pressure}); billed {session.Usage.TotalTokens:N0}"
            : $"~{c.CurrentTokens:N0} tokens{(c.IsEstimate ? " (estimated)" : "")}; billed {session.Usage.TotalTokens:N0}";
    }

    async Task SaveKeys()
    {
        await Creds.SaveToStoreAsync(JS);
        keysSaved = true;
    }

    async Task OnAcknowledgementChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? "";
        if (Enum.TryParse<AiAcknowledgement>(value, out var parsed))
        {
            selectedAcknowledgement = value;
            await Host.UpdateVoice(o => o with { Acknowledgement = parsed });
        }
    }

    async Task OnInterruptionChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? "";
        if (Enum.TryParse<InterruptionMode>(value, out var parsed))
        {
            selectedInterruption = value;
            await Host.UpdateVoice(o => o with { Interruption = parsed });
        }
    }

    async Task NewConversation()
    {
        ShowContext(await Host.NewConversation());
        statusMessage = "Started a new conversation.";
    }

    async Task Compact()
    {
        try
        {
            var session = await Host.GetSession();
            await session.Compact();
            ShowContext(session);
            statusMessage = "Older messages were summarized.";
        }
        catch (Exception ex)
        {
            statusMessage = $"Error: {ex.Message}";
        }
    }

    async Task ClearHistory()
    {
        try
        {
            await Host.DeleteAll();
            ShowContext(await Host.GetSession());
            statusMessage = "All conversations deleted.";
        }
        catch (Exception ex)
        {
            statusMessage = $"Error: {ex.Message}";
        }
    }

    public void Dispose() => cts.Cancel();
}
