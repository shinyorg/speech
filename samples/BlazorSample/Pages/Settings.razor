@page "/settings"
@inject IAiConversationService AiService
@inject CloudProviderCredentials Creds
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Settings</PageTitle>

<div class="settings-container">
    <div class="settings-section">
        <h3>Status</h3>
        <div class="settings-card">
            <div class="settings-row">
                <span class="settings-label">AI Status</span>
                <span class="settings-value">@AiService.Status</span>
            </div>
        </div>
    </div>

    <div class="settings-section">
        <h3>Response Mode</h3>
        <p class="settings-footer">Controls how the AI acknowledges responses.</p>
        <div class="settings-card">
            <div class="settings-row">
                <label class="settings-label" for="acknowledgement">Acknowledgement</label>
                <select id="acknowledgement" value="@selectedAcknowledgement" @onchange="OnAcknowledgementChanged">
                    @foreach (var option in Enum.GetNames<AiAcknowledgement>())
                    {
                        <option value="@option">@option</option>
                    }
                </select>
            </div>
        </div>
    </div>

    @if (Creds.IsActive)
    {
        <div class="settings-section">
            <h3>@Creds.ProviderName API Credentials</h3>
            <p class="settings-footer">Saved to your browser and reused on next launch; changes take effect on the next speech request.</p>
            <div class="settings-card">
                @foreach (var field in Creds.Fields)
                {
                    <div class="settings-row" style="flex-direction: column; align-items: stretch;">
                        <label class="settings-label" for="@field.StoreKey">@field.Label</label>
                        <input id="@field.StoreKey" type="text" @bind="field.Value" placeholder="Enter value" />
                    </div>
                }
                <button class="btn-primary" @onclick="SaveKeys">Apply Keys</button>
                @if (keysSaved)
                {
                    <span class="settings-value">Saved ✓</span>
                }
            </div>
        </div>
    }

    <div class="settings-section">
        <h3>Danger Zone</h3>
        <div class="settings-card">
            <button class="btn-danger" @onclick="ClearHistory">Clear All Chat History</button>
        </div>
    </div>

</div>

@code {
    string selectedAcknowledgement = "";
    string? statusMessage;
    bool keysSaved;

    protected override void OnInitialized()
    {
        AiService.StatusChanged += OnStatusChanged;
        selectedAcknowledgement = AiService.Acknowledgement.ToString();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Make sure the fields reflect the persisted values even on a direct navigation to /settings.
        if (firstRender && Creds.IsActive)
        {
            await Creds.RestoreFromStoreAsync(JS);
            StateHasChanged();
        }
    }

    async Task SaveKeys()
    {
        await Creds.SaveToStoreAsync(JS);
        keysSaved = true;
    }

    void OnAcknowledgementChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? "";
        if (Enum.TryParse<AiAcknowledgement>(value, out var parsed))
        {
            AiService.Acknowledgement = parsed;
            selectedAcknowledgement = value;
        }
    }

    async Task ClearHistory()
    {
        try
        {
            await AiService.ClearChatHistory();
            statusMessage = "Chat history cleared.";
        }
        catch (Exception ex)
        {
            statusMessage = $"Error: {ex.Message}";
        }
    }

    void OnStatusChanged(AiState state)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AiService.StatusChanged -= OnStatusChanged;
    }
}
