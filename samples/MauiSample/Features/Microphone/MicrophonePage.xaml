<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MauiSample.Features.Microphone"
             x:Class="MauiSample.Features.Microphone.MicrophonePage"
             x:DataType="local:MicrophoneViewModel"
             Title="Microphone">
    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="16">

            <!-- Live monitor -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                    Padding="16"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                    StrokeThickness="1">
                <VerticalStackLayout Spacing="14">
                    <Label Text="LIVE MONITOR"
                           FontSize="11"
                           FontFamily="OpenSansSemibold"
                           TextColor="{StaticResource Gray400}" />
                    <Label Text="{Binding StatusText}"
                           FontSize="14"
                           TextColor="{StaticResource Primary}" />

                    <Label Text="Input level"
                           FontSize="11"
                           TextColor="{StaticResource Gray400}" />
                    <ProgressBar Progress="{Binding Level}"
                                 ProgressColor="{StaticResource Primary}" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Text="Gain" VerticalOptions="Center" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Gain}" />
                    </Grid>

                    <Button Text="{Binding MonitorButtonText}"
                            Command="{Binding ToggleMonitorCommand}"
                            CornerRadius="12"
                            FontSize="16"
                            HeightRequest="54" />
                </VerticalStackLayout>
            </Border>

            <!-- Current routes (display only) -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                    Padding="16"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                    StrokeThickness="1">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                    <Label Grid.ColumnSpan="2"
                           Text="AUDIO ROUTES"
                           FontSize="11"
                           FontFamily="OpenSansSemibold"
                           TextColor="{StaticResource Gray400}" />

                    <Label Grid.Row="1" Grid.Column="0" Text="🎙 Input" VerticalOptions="Center" TextColor="{StaticResource Gray400}" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding CurrentInputText}" FontFamily="OpenSansSemibold" />

                    <Label Grid.Row="2" Grid.Column="0" Text="🔊 Output" VerticalOptions="Center" TextColor="{StaticResource Gray400}" />
                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding CurrentOutputText}" FontFamily="OpenSansSemibold" />
                </Grid>
            </Border>

            <!-- Voice processing -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                    Padding="16"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                    StrokeThickness="1">
                <VerticalStackLayout Spacing="10">
                    <Label Text="VOICE PROCESSING"
                           FontSize="11"
                           FontFamily="OpenSansSemibold"
                           TextColor="{StaticResource Gray400}" />
                    <Label Text="Echo cancellation fights feedback, but on iOS it forces Bluetooth to the low-quality call profile — a Bluetooth speaker then drops back to the phone. Leave off to route to a Bluetooth speaker; turn on when using the phone speaker up close. Applies on next Start."
                           FontSize="11"
                           TextColor="{StaticResource Gray400}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Echo Cancellation" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding EchoCancellation}" OnColor="{StaticResource Primary}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Noise Suppression" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding NoiseSuppression}" OnColor="{StaticResource Primary}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Automatic Gain Control" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding AutomaticGainControl}" OnColor="{StaticResource Primary}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Effects -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                    Padding="16"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                    StrokeThickness="1">
                <VerticalStackLayout Spacing="10">
                    <Label Text="EFFECTS"
                           FontSize="11"
                           FontFamily="OpenSansSemibold"
                           TextColor="{StaticResource Gray400}" />
                    <Label Text="Every control here is live — toggle a switch or drag a slider while recording and you hear it on the next buffer. No restart, no clicks."
                           FontSize="11"
                           TextColor="{StaticResource Gray400}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="All effects" VerticalOptions="Center" FontFamily="OpenSansSemibold" />
                        <Switch Grid.Column="1" IsToggled="{Binding EffectsEnabled}" OnColor="{StaticResource Primary}" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource Gray600}" Opacity="0.4" />

                    <!-- Pitch -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Pitch shift" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding PitchEnabled}" OnColor="{StaticResource Primary}" />
                    </Grid>
                    <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                        <Label Text="{Binding PitchSemitones, StringFormat='{0:+0;-0;0} st'}"
                               VerticalOptions="Center"
                               FontSize="12"
                               TextColor="{StaticResource Gray400}" />
                        <Slider Grid.Column="1" Minimum="-12" Maximum="12" Value="{Binding PitchSemitones}" />
                    </Grid>

                    <!-- Echo -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Echo" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding EchoEnabled}" OnColor="{StaticResource Primary}" />
                    </Grid>
                    <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                        <Label Text="{Binding EchoDelayMs, StringFormat='{0:0} ms'}"
                               VerticalOptions="Center"
                               FontSize="12"
                               TextColor="{StaticResource Gray400}" />
                        <Slider Grid.Column="1" Minimum="20" Maximum="1000" Value="{Binding EchoDelayMs}" />
                    </Grid>
                    <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                        <Label Text="{Binding EchoMix, StringFormat='mix {0:0.00}'}"
                               VerticalOptions="Center"
                               FontSize="12"
                               TextColor="{StaticResource Gray400}" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding EchoMix}" />
                    </Grid>

                    <!-- Reverb -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Reverb" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding ReverbEnabled}" OnColor="{StaticResource Primary}" />
                    </Grid>
                    <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                        <Label Text="{Binding ReverbRoomSize, StringFormat='room {0:0.00}'}"
                               VerticalOptions="Center"
                               FontSize="12"
                               TextColor="{StaticResource Gray400}" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding ReverbRoomSize}" />
                    </Grid>
                    <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                        <Label Text="{Binding ReverbMix, StringFormat='mix {0:0.00}'}"
                               VerticalOptions="Center"
                               FontSize="12"
                               TextColor="{StaticResource Gray400}" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding ReverbMix}" />
                    </Grid>

                    <!-- Ring modulator -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Robot (ring mod)" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding RobotEnabled}" OnColor="{StaticResource Primary}" />
                    </Grid>
                    <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                        <Label Text="{Binding RobotFrequency, StringFormat='{0:0} Hz'}"
                               VerticalOptions="Center"
                               FontSize="12"
                               TextColor="{StaticResource Gray400}" />
                        <Slider Grid.Column="1" Minimum="10" Maximum="400" Value="{Binding RobotFrequency}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Record & Play -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                    Padding="16"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                    StrokeThickness="1">
                <VerticalStackLayout Spacing="10">
                    <Label Text="RECORD &amp; PLAY"
                           FontSize="11"
                           FontFamily="OpenSansSemibold"
                           TextColor="{StaticResource Gray400}" />
                    <Label Text="{Binding RecordStatus}"
                           FontSize="12"
                           TextColor="{StaticResource Gray400}" />

                    <Label Text="Wet records the effects, Dry records the raw mic, Both writes two files so you can compare."
                           FontSize="11"
                           TextColor="{StaticResource Gray400}" />
                    <Picker ItemsSource="{Binding RecordModes}"
                            SelectedItem="{Binding SelectedRecordMode}"
                            IsEnabled="{Binding CanChangeRecordMode}"
                            Title="Record mode" />

                    <Label Text="Level"
                           FontSize="11"
                           TextColor="{StaticResource Gray400}" />
                    <ProgressBar Progress="{Binding Level}"
                                 ProgressColor="{StaticResource Primary}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                Text="{Binding RecordButtonText}"
                                Command="{Binding ToggleRecordCommand}"
                                CornerRadius="12"
                                FontSize="16"
                                HeightRequest="50" />
                        <Button Grid.Column="1"
                                Text="▶  Play"
                                Command="{Binding PlayCommand}"
                                IsEnabled="{Binding CanPlay}"
                                CornerRadius="12"
                                FontSize="16"
                                HeightRequest="50" />
                    </Grid>
                    <Button Text="▶  Play dry take"
                            Command="{Binding PlayDryCommand}"
                            IsEnabled="{Binding CanPlayDry}"
                            IsVisible="{Binding CanPlayDry}"
                            CornerRadius="12"
                            FontSize="14"
                            HeightRequest="44" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
