<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <IsAotCompatible>true</IsAotCompatible>
        <Description>AG-UI for Shiny AI Conversation - run a session as an AG-UI event stream (so AG-UI front ends such as the Shiny AgentView render it, questions included), let the model draw A2UI surfaces with a render_ui tool, and talk to a remote AG-UI agent as the session's chat client</Description>
        <PackageTags>ai chat agent ag-ui agui a2ui generative-ui copilot</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AGUI.Abstractions"/>
        <PackageReference Include="AGUI.Client"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Shiny.AiConversation\Shiny.AiConversation.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Shiny.AiConversation.Tests"/>
    </ItemGroup>

</Project>
