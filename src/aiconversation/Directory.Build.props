<Project>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

    <PropertyGroup>
        <Description>Shiny AI Conversation - Voice chat with your AI in your .NET apps</Description>
        <PackageTags>maui ai chat copilot speech wake-word tts stt</PackageTags>
        <PackageReleaseNotes>https://github.com/shinyorg/speech/releases</PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)readme.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
